    "@repo/database":    "workspace:*"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/bun": "latest",
    "@types/node": "^20.0.0",
    "typescript":  "^5.4.0"
  }
}
