{
  "name": "auth-service",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev":       "node --watch --import tsx/esm src/index.ts",
    "build":     "tsc",
    "start":     "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test":      "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "hono":               "^4.7.0",
    "effect":             "^3.15.0",
    "better-auth":        "^1.2.7",
    "drizzle-orm":        "^0.41.0",
    "@hono/node-server":  "^1.14.0",
    "@repo/env":          "workspace:*",
    "@repo/common":       "workspace:*",
    "@repo/database":     "workspace:*"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node":  "^20.0.0",
    "@vitest/coverage-v8": "^1.6.0",
    "tsx":          "^4.19.0",
    "typescript":   "^5.4.0",
    "vitest":       "^1.6.0"
  }
}
