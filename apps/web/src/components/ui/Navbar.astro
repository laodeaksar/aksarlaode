---
const navLinks = [
  { href: "/",         label: "Home"     },
  { href: "/products", label: "Products" },
]
---
<nav class="sticky top-0 z-50 bg-white border-b border-gray-200 shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <a href="/" class="text-xl font-bold text-gray-900">MyEcommerce</a>

      <div class="hidden md:flex items-center gap-6">
        {navLinks.map(l => (
          <a href={l.href} class="text-sm font-medium text-gray-600 hover:text-gray-900 transition-colors">
            {l.label}
          </a>
        ))}
      </div>

      <div class="flex items-center gap-3">
        <a href="/cart" class="relative p-2 rounded-full hover:bg-gray-100 transition-colors" aria-label="Cart">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-gray-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
          </svg>
        </a>
        <a href="/account/login" class="text-sm font-medium text-white bg-gray-900 hover:bg-gray-700 px-4 py-2 rounded-lg transition-colors">
          Login
        </a>
      </div>
    </div>
  </div>
</nav>
