# ============================================================
# .env.example — copy to .env and fill in your values.
# Variables are grouped by which service reads them.
# ============================================================

# ── Node ──────────────────────────────────────────────────────────────────────
# Scope: all services
NODE_ENV=development                          # development | test | production


# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Scope: @repo/database, auth-service
POSTGRES_USER=ecuser
POSTGRES_PASSWORD=ecpassword
POSTGRES_DB=ecommerce
DATABASE_URL=postgresql://ecapp:ecapppassword@localhost:5432/ecommerce


# ── MongoDB ───────────────────────────────────────────────────────────────────
# Scope: @repo/database (order-service data)
MONGO_USER=ecuser
MONGO_PASSWORD=ecpassword
MONGODB_URL=mongodb://ecuser:ecpassword@localhost:27017/ecommerce?authSource=admin


# ── Redis ─────────────────────────────────────────────────────────────────────
# Scope: api-gateway (rate limiting, caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=ecredis                        # set empty string for no-auth (dev)


# ── Auth & security ───────────────────────────────────────────────────────────
# Scope: auth-service, api-gateway
#
# Generate strong secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-min-32-chars-long-secret-key-xxxxxxxxxxxxxxxx
INTERNAL_SERVICE_TOKEN=change-me-min-32-chars-internal-token-yyyyyyyy


# ── Internal service base URLs ────────────────────────────────────────────────
# Scope: api-gateway (proxy targets)
AUTH_SERVICE_URL=http://localhost:3001
PRODUCT_SERVICE_URL=http://localhost:3002
ORDER_SERVICE_URL=http://localhost:3003
PAYMENT_SERVICE_URL=http://localhost:3004


# ── Public URLs ───────────────────────────────────────────────────────────────
# Scope: api-gateway, auth-service (CORS trusted origins)
PUBLIC_API_URL=http://localhost:3000
WEB_URL=http://localhost:4321
ADMIN_URL=http://localhost:4322


# ── Midtrans (payment gateway) ────────────────────────────────────────────────
# Scope: payment-service, api-gateway
# Get keys from: https://dashboard.midtrans.com/settings/config_info
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false
PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxx


# ── Mail ──────────────────────────────────────────────────────────────────────
# Scope: notification-service / api-gateway
# For local dev, use Mailpit (included in docker-compose): http://localhost:8025
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASS=
MAIL_FROM_ADDRESS=no-reply@myecommerce.com
MAIL_FROM_NAME=My Ecommerce


# ── Seed (optional) ───────────────────────────────────────────────────────────
# Scope: pnpm db:seed — override defaults when seeding the database
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_PASSWORD=Admin1234!
