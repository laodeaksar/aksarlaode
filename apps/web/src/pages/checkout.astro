---
import { CheckoutForm } from "@/components/islands/checkout/CheckoutForm"
import Layout from "@/layouts/Layout.astro"

// Middleware already guards /checkout and sets Astro.locals.user.
// This is a safety net in case the PROTECTED list and this page drift apart.
const user = Astro.locals.user
if (!user) {
  return Astro.redirect("/account/login?redirect=/checkout")
}

const midtransHost =
  import.meta.env.PUBLIC_MIDTRANS_ENV === "production"
    ? "https://app.midtrans.com"
    : "https://app.sandbox.midtrans.com"
---

<Layout title="Checkout">
  <!-- Midtrans Snap script -->
  <script
    is:inline
    src={`${midtransHost}/snap/snap.js`}
    data-client-key={import.meta.env.PUBLIC_MIDTRANS_CLIENT_KEY}
  ></script>

  <div class="max-w-2xl mx-auto px-4 py-10">
    <h1 class="text-2xl font-bold mb-8">Checkout</h1>

    <CheckoutForm
      client:load
      userId={user.id}
      userEmail={user.email}
    />
  </div>
</Layout>
