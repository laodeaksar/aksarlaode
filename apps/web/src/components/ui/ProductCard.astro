---
interface Props {
  id:        string
  name:      string
  slug:      string
  price:     number
  imageUrl?: string
  category?: string
  inStock:   boolean
}
const { id, name, slug, price, imageUrl, category, inStock } = Astro.props
---
<a href={`/products/${slug}`} class="group block rounded-xl border border-gray-200 bg-white hover:shadow-md transition-shadow overflow-hidden">
  <div class="aspect-square overflow-hidden bg-gray-100">
    <img
      src={imageUrl ?? "/placeholder.png"}
      alt={name}
      class="h-full w-full object-cover group-hover:scale-105 transition-transform duration-300"
      loading="lazy"
    />
  </div>
  <div class="p-4">
    {category && <p class="text-xs text-gray-500 uppercase tracking-wide mb-1">{category}</p>}
    <h3 class="text-sm font-semibold text-gray-900 line-clamp-2 mb-2">{name}</h3>
    <div class="flex items-center justify-between">
      <span class="text-base font-bold text-gray-900">
        Rp {price.toLocaleString("id-ID")}
      </span>
      {!inStock && (
        <span class="text-xs text-red-500 font-medium">Out of stock</span>
      )}
    </div>
  </div>
</a>
