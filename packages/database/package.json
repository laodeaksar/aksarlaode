{
  "name": "@repo/database",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./mongodb": "./src/mongodb/index.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --import tsx/esm src/postgres/migrate.ts",
    "db:seed": "node --import tsx/esm src/postgres/seed.ts",
    "db:studio": "drizzle-kit studio",
    "format:write": "prettier --write \"**/*.{ts,tsx,mdx}\" --cache",
    "format:check": "prettier --check \"**/*.{ts,tsx,mdx}\" --cache"
  },
  "dependencies": {
    "drizzle-orm": "^0.41.0",
    "mongoose": "^8.13.0",
    "pg": "^8.14.0",
    "@repo/env": "workspace:*"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.19.0",
    "@repo/typescript-config": "workspace:*",
    "typescript": "^5.4.0"
  }
}
