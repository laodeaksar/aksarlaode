{
  "name": "auth-service",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun run dist/index.js",
    "typecheck":    "tsc --noEmit",
    "clean":        "rm -rf dist",
    "test":         "vitest run",
    "test:watch":   "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "elysia":              "^1.1.0",
    "@elysiajs/cors":      "^1.1.0",
    "@elysiajs/swagger":   "^1.3.1",
    "effect":         "^3.15.0",
    "better-auth":    "^1.2.7",
    "drizzle-orm":    "^0.41.0",
    "ioredis":        "^5.4.2",
    "@repo/env":      "workspace:*",
    "@repo/common":   "workspace:*",
    "@repo/database": "workspace:*"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/bun":              "latest",
    "@types/node":             "^20.0.0",
    "@vitest/coverage-v8":     "^1.6.0",
    "typescript":              "^5.4.0",
    "vitest":                  "^1.6.0"
  }
}
