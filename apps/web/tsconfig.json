{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
      "@repo/ui/*": ["../../packages/ui/src/*"]
    },
    "strictNullChecks": true
  },
  "include": ["src", ".astro/types.d.ts"],
  "exclude": ["node_modules"]
}
