{
  "name": "product-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev":       "tsx watch src/index.ts",
    "build":     "tsc",
    "start":     "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "clean":     "rm -rf dist",
    "test":      "vitest run"
  },
  "dependencies": {
    "elysia":              "^1.1.0",
    "@elysiajs/cors":      "^1.1.0",
    "@elysiajs/swagger":   "^1.1.0",
    "effect":              "^3.4.0",
    "drizzle-orm":         "^0.41.0",
    "@repo/env":           "workspace:*",
    "@repo/common":        "workspace:*",
    "@repo/database":      "workspace:*"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^20.0.0",
    "tsx":         "^4.19.0",
    "typescript":  "^5.4.0"
  }
}
