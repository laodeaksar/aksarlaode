---
import Navbar from "@/components/ui/Navbar.astro"
import Footer from "@/components/ui/Footer.astro"
import { AppRuntime } from "@/lib/effect/runtime"
import { ordersApi }  from "@/lib/api/orders"

const cookie = Astro.request.headers.get("cookie") ?? ""
const exit   = await AppRuntime.runPromiseExit(ordersApi.list(cookie))
const orders = exit._tag === "Success" ? exit.value.items : []
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My Orders - MyEcommerce</title>
  </head>
  <body class="bg-gray-50 min-h-screen">
    <Navbar />
    <main class="max-w-3xl mx-auto px-4 py-10">
      <h1 class="text-2xl font-bold text-gray-900 mb-6">My Orders</h1>
      {orders.length === 0 ? (
        <p class="text-gray-500 text-center py-16">You have no orders yet.</p>
      ) : (
        <div class="space-y-4">
          {orders.map((o: any) => (
            <div class="bg-white rounded-xl border border-gray-200 p-5">
              <div class="flex items-center justify-between mb-2">
                <span class="font-mono font-semibold text-gray-900">{o.orderId}</span>
                <span class="text-xs font-medium px-2 py-1 rounded-full bg-gray-100 text-gray-700">{o.status}</span>
              </div>
              <p class="text-sm text-gray-500">Total: Rp {o.totalAmount?.toLocaleString("id-ID")}</p>
              <p class="text-xs text-gray-400 mt-1">{new Date(o.createdAt).toLocaleDateString()}</p>
            </div>
          ))}
        </div>
      )}
    </main>
    <Footer />
  </body>
</html>
