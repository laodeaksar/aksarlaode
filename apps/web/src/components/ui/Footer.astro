<footer class="bg-gray-900 text-gray-400 mt-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div>
        <h3 class="text-white font-semibold text-lg mb-3">MyEcommerce</h3>
        <p class="text-sm">Your one-stop shop for quality products at great prices.</p>
      </div>
      <div>
        <h4 class="text-white font-medium mb-3">Quick Links</h4>
        <ul class="space-y-2 text-sm">
          <li><a href="/"         class="hover:text-white transition-colors">Home</a></li>
          <li><a href="/products" class="hover:text-white transition-colors">Products</a></li>
          <li><a href="/cart"     class="hover:text-white transition-colors">Cart</a></li>
        </ul>
      </div>
      <div>
        <h4 class="text-white font-medium mb-3">Account</h4>
        <ul class="space-y-2 text-sm">
          <li><a href="/account/login"    class="hover:text-white transition-colors">Login</a></li>
          <li><a href="/account/register" class="hover:text-white transition-colors">Register</a></li>
          <li><a href="/account/orders"   class="hover:text-white transition-colors">My Orders</a></li>
        </ul>
      </div>
    </div>
    <div class="border-t border-gray-800 mt-8 pt-8 text-sm text-center">
      &copy; {new Date().getFullYear()} MyEcommerce. All rights reserved.
    </div>
  </div>
</footer>
