---
import { CartDrawer } from "@/components/islands/cart/CartDrawer"
import { NavbarActions } from "@/components/islands/ui/NavbarActions"

const navLinks = [
  { href: "/",         label: "Home"     },
  { href: "/products", label: "Products" },
]
---
<nav class="sticky top-0 z-50 bg-white border-b border-gray-200 shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <a href="/" class="text-xl font-bold text-gray-900">MyEcommerce</a>

      <div class="hidden md:flex items-center gap-6">
        {navLinks.map(l => (
          <a href={l.href} class="text-sm font-medium text-gray-600 hover:text-gray-900 transition-colors">
            {l.label}
          </a>
        ))}
      </div>

      <div class="flex items-center gap-3">
        <!-- Cart badge: React island so it updates reactively when items are added -->
        <CartDrawer client:load />
        <!-- Auth actions: shows Login or Hi {name} + Logout based on localStorage -->
        <NavbarActions client:load />
      </div>
    </div>
  </div>
</nav>
